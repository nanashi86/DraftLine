{
  "name": "DraftLine",
  "short_name": "DraftLine",
  "description": "Free, open-source screenwriting app for desktop and phone: a screenplay editor with exact Hollywood pagination, Final Draft and Fountain files, Scene Board, Story Bible and Characters. Works offline.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
